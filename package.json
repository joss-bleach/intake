{
  "name": "intake",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n client,server -c blue,green \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite",
    "dev:server": "tsx watch --env-file-if-exists=.env.local src/server/index.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:up": "docker compose up -d postgres",
    "observability:up": "docker compose up -d glitchtip-web glitchtip-worker",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/server/db/migrate.ts",
    "food:ingest-off": "tsx src/server/food/off-ingest.ts",
    "food:ingest-cofid": "tsx src/server/food/cofid-ingest.ts",
    "eval": "tsx src/eval/run.ts",
    "eval:corrections-queue": "tsx src/eval/corrections-queue.ts",
    "observability:tripwire": "tsx src/server/observability/tripwire.ts",
    "infra:deploy": "alchemy deploy",
    "infra:destroy": "alchemy destroy"
  },
  "dependencies": {
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@react-email/render": "^2.1.0",
    "@sentry/node": "^10.70.0",
    "@t3-oss/env-core": "^0.13.11",
    "@tanstack/query-async-storage-persister": "^5.101.4",
    "@tanstack/query-persist-client-core": "^5.101.4",
    "@tanstack/react-query": "^5.101.4",
    "@trpc/client": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "@trpc/tanstack-react-query": "^11.18.0",
    "ai": "^7.0.62",
    "better-auth": "^1.6.27",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.45.2",
    "effect": "^3.22.1",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.31.0",
    "motion": "^13.1.0",
    "pg": "^8.23.0",
    "input-otp": "^1.4.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "resend": "^6.19.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.78.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@types/cors": "^2.8.19",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "alchemy": "0.94.0",
    "concurrently": "^10.0.4",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^30.0.1",
    "oxlint": "1.78.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
