# Copy to .env and adjust as needed. Matches docker-compose.yml's postgres
# service for local dev; CI sets its own DATABASE_URL against the workflow's
# postgres service container.
DATABASE_URL=postgres://intake:intake@localhost:5432/intake
PORT=3001
# Optional — unset locally/CI is fine; AI-calling code paths fail with
# AiSdkError until one is provisioned (see src/ai/effect-ai-sdk.ts).
OPENROUTER_API_KEY=
