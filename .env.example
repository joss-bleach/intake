# Copy to .env.local and adjust as needed. Matches docker-compose.yml's postgres
# service for local dev; CI sets its own DATABASE_URL against the workflow's
# postgres service container.
DATABASE_URL=postgres://intake:intake@localhost:5432/intake
PORT=3001
# Optional — unset locally/CI is fine; AI-calling code paths fail with
# AiSdkError until one is provisioned (see src/ai/effect-ai-sdk.ts).
OPENROUTER_API_KEY=
# Optional — unset locally/CI is fine; captureEffectFailure no-ops until a
# real GlitchTip project DSN is provisioned (see
# src/server/observability/glitchtip.ts). Run `pnpm observability:up` for a
# local GlitchTip instance to get one from.
GLITCHTIP_DSN=
# The cron tripwire (src/server/observability/tripwire.ts) alerts via
# GlitchTip once model_calls passes this many rows.
MODEL_CALLS_TRIPWIRE_THRESHOLD=500000
# Sign-in (issue #87, ADR 0006) — signs betterauth's session cookies.
# Required, no default: a defaulted signing secret would let anyone who has
# read this repo forge a session cookie. Generate your own, per environment:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=
# Where betterauth's own /api/auth/* handler is reachable from.
BETTER_AUTH_URL=http://localhost:3001
# The client origin allowed to make credentialed auth requests.
CLIENT_ORIGIN=http://localhost:5173
# Optional — unset locally/CI is fine; sending an OTP email throws until one
# is provisioned. Get one from https://resend.com.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Intake <onboarding@resend.dev>
